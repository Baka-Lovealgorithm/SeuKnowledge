# Copy this file to .env before the first Docker Compose startup. Do not commit .env.

# Image and public endpoint
APP_TAG=dev
FRONTEND_PORT=8088
# Keep AI extraction pages and configuration hidden by default. Set true and rebuild frontend to restore.
VITE_ENABLE_AI_EXTRACTION=false

# Service image versions. ES and its analysis-smartcn plugin must stay identical.
MYSQL_VERSION=8.4.4
ES_VERSION=8.17.6
ES_HEAP_MB=512
REDIS_VERSION=7.4.2

# Required secrets. Use strong, unique values in any shared environment.
MYSQL_DB=seuknowledge
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
SEUKNOWLEDGE_SECURITY_ADMIN_USERNAME=admin
SEUKNOWLEDGE_SECURITY_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Optional document parsing. Set both values to use LlamaParse for HTML/PDF/DOCX.
KB_LLAMAPARSE_ENABLED=false
LLAMA_CLOUD_API_KEY=

# Production logging should not write prompts or model outputs.
LOG_LEVEL_LLM=info
